{
  "name": "noiir",
  "version": "0.1.0",
  "description": "One primitive, <Frame>, instead of div + CSS. A CRT wireframe standard library, UX lint rules, and a /noiir Claude Code skill.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "skill"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/noiir.js"
    },
    "./lint": "./dist/lint/lint/index.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite playground",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/fix-dts.ts && tsc -p tsconfig.lint.json && node scripts/build-skill.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "audit": "node scripts/audit.ts",
    "compare": "node scripts/measure.ts",
    "bench": "node scripts/bench.ts",
    "build:skill": "node scripts/build-skill.ts",
    "skill:install": "node scripts/build-skill.ts --install"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
